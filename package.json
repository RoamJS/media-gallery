{
  "name": "media-gallery",
  "version": "0.1.0",
  "description": "Browse, search, upload, copy, and manage media referenced in your graph.",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "samepage dev",
    "build:roam": "samepage build --dry",
    "test": "samepage test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "roam",
    "roam-research",
    "roamjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "roamjs-components": "^0.86.4"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "samepage": {
    "extends": "node_modules/roamjs-components/package.json",
    "entry": [
      "workers/semantic.ts"
    ],
    "out": "[name]",
    "include": "extension.css",
    "finish": "scripts/embedSemanticWorker.cjs"
  }
}
